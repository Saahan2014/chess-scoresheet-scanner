# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: which OpenAI model reads the sheets. Defaults to gpt-6.1-sol, with automatic fallback.
# After fine-tuning on your own scoresheets, put the fine-tuned model id here.
OPENAI_MODEL=

# Required for the Train page: any password you choose, so visitors can't start paid training jobs.
TRAIN_PASSWORD=
